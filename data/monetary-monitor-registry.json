{
  "schema_version": 1,
  "updated_at": "2026-09-22",
  "purpose": "Source registry for global monetary and financial institutional monitoring. The registry defines discovery coverage, polling priority and primary-source entry points; it is operational metadata, not public evidence.",
  "coverage_policy": {
    "rule": "jurisdiction-complete",
    "bis_baseline": {
      "source": "https://www.bis.org/about/organisation/members",
      "current_members": 63,
      "note": "All BIS member central banks and monetary authorities are eligible regardless of tier."
    },
    "imf_remainder": {
      "source": "https://www.imf.org/external/np/sec/memdir/memdate.htm",
      "current_members": 191,
      "note": "Use IMF member jurisdictions to identify central banks, currency boards, monetary authorities and currency-union members not already captured by the BIS baseline."
    },
    "non_imf_and_territorial": "Add monetary authorities with material currency, reserve, payment or cross-border-finance relevance even when the jurisdiction is not an IMF member.",
    "review_frequency": "monthly"
  },
  "polling_tiers": {
    "A": {
      "frequency": "daily",
      "description": "Systemic monetary nodes and major regional transmission hubs."
    },
    "B": {
      "frequency": "business-daily",
      "description": "Other BIS member central banks and monetary authorities."
    },
    "C": {
      "frequency": "weekly-and-event-driven",
      "description": "Remaining national, currency-board and territorial monetary authorities."
    },
    "M": {
      "frequency": "business-daily-and-event-driven",
      "description": "Multilateral monetary, sovereign-finance, prudential and development-finance institutions."
    }
  },
