    "publication_thresholds": {
      "80-100": "event-driven flash plus weekly/monthly inclusion",
      "50-79": "daily pulse when material plus weekly ledger",
      "20-49": "ledger; publish only as part of a broader pattern",
      "0-19": "archive"
