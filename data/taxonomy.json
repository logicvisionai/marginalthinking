    "energy-materials-industrial-systems": {
      "program": "technology-production-society",
      "en": "Energy, Materials & Industrial Systems",
      "pt-BR": "Energia, Materiais & Sistemas Industriais",
      "description": {
        "en": "Research on how energy, materials and industrial systems change costs, productive capacity, dependencies, capital allocation and economic or strategic capability.",
        "pt-BR": "Pesquisa sobre como energia, materiais e sistemas industriais alteram custos, capacidade produtiva, dependências, alocação de capital e capacidades econômicas ou estratégicas."
      },
      "domains": {
        "electricity-systems": {
          "en": "Electricity Systems",
          "pt-BR": "Sistemas Elétricos"
        },
        "fuels-energy-carriers": {
          "en": "Fuels & Energy Carriers",
          "pt-BR": "Combustíveis & Vetores Energéticos"
        },
        "strategic-advanced-materials": {
          "en": "Strategic & Advanced Materials",
          "pt-BR": "Materiais Estratégicos & Avançados"
        },
        "industrial-capacity-supply-chains": {
          "en": "Industrial Capacity & Supply Chains",
          "pt-BR": "Capacidade Industrial & Cadeias de Suprimento"
        }
      },
      "analytical_chain": {
        "en": "resource → technology → production → infrastructure → cost → scale → dependencies → capital → capacity/power → consequences",
        "pt-BR": "recurso → tecnologia → produção → infraestrutura → custo → escala → dependências → capital → capacidade/poder → consequências"
      }
    },
    "global-monetary-financial-institutions": {
      "program": "political-economy-markets",
      "en": "Global Monetary & Financial Institutions",
      "pt-BR": "Instituições Monetárias & Financeiras Globais",
      "description": {
        "en": "Research on how central banks, multilateral lenders, financial standard setters and public settlement institutions change interest rates, liquidity, reserves, credit conditions, debt frameworks, financial regulation and cross-border monetary infrastructure.",
        "pt-BR": "Pesquisa sobre como bancos centrais, credores multilaterais, formuladores de padrões financeiros e instituições públicas de liquidação alteram juros, liquidez, reservas, condições de crédito, marcos de dívida, regulação financeira e infraestrutura monetária transfronteiriça."
      },
      "domains": {
        "system-monitor": {
          "en": "Global Institutional Monitor",
          "pt-BR": "Monitor Institucional Global"
        },
        "central-banks": {
          "en": "Central Banks",
          "pt-BR": "Bancos Centrais"
        },
        "multilateral-finance": {
          "en": "Multilateral Finance",
          "pt-BR": "Finanças Multilaterais"
        },
        "financial-stability-regulation": {
          "en": "Financial Stability & Regulation",
          "pt-BR": "Estabilidade Financeira & Regulação"
        },
        "monetary-infrastructure-reserves": {
          "en": "Monetary Infrastructure & Reserves",
          "pt-BR": "Infraestrutura Monetária & Reservas"
        }
      },
      "analytical_chain": {
        "en": "institutional decision → monetary/financial mechanism → balance sheets and prices → financing conditions → distribution and capacity → second-order effects",
        "pt-BR": "decisão institucional → mecanismo monetário/financeiro → balanços e preços → condições de financiamento → distribuição e capacidade → efeitos de segunda ordem"
      }
    },
    "policy-experiments-institutional-transitions": {
      "program": "political-economy-markets",
      "en": "Policy Experiments & Institutional Transitions",
      "pt-BR": "Experimentos de Política & Transições Institucionais",
      "description": {
        "en": "Deep case studies of implemented reforms, programs and institutional transitions, reconstructing design, incentives, sequencing, financing, implementation, outcomes, distributional effects, second-order consequences, durability and limits to transfer across contexts.",
        "pt-BR": "Estudos de caso aprofundados sobre reformas, programas e transições institucionais implementadas, reconstruindo desenho, incentivos, sequência, financiamento, execução, resultados, efeitos distributivos, consequências de segunda ordem, durabilidade e limites de transferência entre contextos."
      },
      "analytical_chain": {
        "en": "problem → institutional design → incentives → implementation → financing → adaptation → outcomes → distribution → second-order effects → durability → transfer limits",
        "pt-BR": "problema → desenho institucional → incentivos → implementação → financiamento → adaptação → resultados → distribuição → efeitos de segunda ordem → durabilidade → limites de transferência"
      },
