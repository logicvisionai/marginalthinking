{
  "name": "marginal-thinking",
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.23.0",
    "sharp": "0.34.3",
    "zod": "^4.4.3",
    "d3-geo": "3.1.1",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "wrangler": "4.133.0"
  },
  "scripts": {
    "prepare:copy": "node scripts/apply-institutional-copy.mjs",
    "validate:pipeline": "node scripts/validate-pipeline.mjs",
    "validate:series": "node scripts/validate-series.mjs",
    "validate": "npm run validate:pipeline && node scripts/validate-research.mjs && npm run validate:prose && npm run validate:series",
    "render": "npm run prepare:copy && node scripts/render-site.mjs",
    "mcp:catalog": "node scripts/render-mcp-catalog.mjs",
    "validate:dist": "node scripts/validate-dist.mjs",
    "build": "npm run prepare:copy && npm run validate && bash scripts/cloudflare-build.sh",
    "validate:prose": "node scripts/validate-public-prose.mjs"
  }
}
