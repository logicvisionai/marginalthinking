{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "marginalthinking",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/mcp", "/mcp/*"],
    "not_found_handling": "404-page"
  }
}
